# Copy to .env and fill in your own keys. .env is gitignored: never commit it.
# Restart Metro (npx expo start) after changing these.
#
# Note: Expo bundles these values into the app, so anyone with a build can
# extract them. Fine for local development; a published app should call these
# APIs through a backend instead.

# Google Gemini (AI chat, visualizations): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Finnhub (news, quotes): https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Alpha Vantage (optional fallback for price history): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
