# Copy to .env and fill in. .env is gitignored: never commit it.
# Restart Metro (npx expo start) after changing this.
#
# Do NOT put API keys (Gemini, Finnhub, Alpha Vantage) here. Expo bundles
# EXPO_PUBLIC_* values into the app, where anyone with a build can read them.
# Those keys are secrets on the API proxy instead: see proxy/README.md.

# URL of the API proxy (Cloudflare Worker in proxy/). Not a secret.
#   Local:    http://localhost:8787   (cd proxy && npm run dev)
#   Deployed: https://equinox-api-proxy.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_PROXY_URL=http://localhost:8787
